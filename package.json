{
  "name": "vivekapatel-portfolio",
  "type": "module",
  "version": "0.13.0",
  "private": true,
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "build": "node tools/generate-sitemap.js && vite build && node tools/generate-static-route-html.js",
    "preview": "vite preview --host :: --port 3000",
    "qa:playwright:passive": "playwright test -c tests/qa/qa.config.js",
    "qa:playwright:ci": "playwright test -c tests/qa/qa.config.js --project=preview-desktop --project=preview-mobile",
    "qa:playwright:live-contact": "QA_LIVE_CONTACT_SUBMIT=1 playwright test -c tests/qa/qa.config.js --project=prod-live-contact-submit",
    "qa:seo": "node tests/qa/qa-seo-check.js",
    "convex:dev": "convex dev",
    "convex:smoke": "node tools/convex-smoke-test.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/traverse": "^7.26.4",
    "@emotion/is-prop-valid": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@sentry/react": "^7.100.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "convex": "^1.41.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.285.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "6.16.0",
    "tailwind-merge": "^1.1.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.27.0",
    "@babel/parser": "^7.27.0",
    "@babel/types": "^7.27.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.8.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "convex-test": "^0.0.53",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "terser": "^5.39.0",
    "vite": "^4.4.5",
    "vitest": "^4.1.8"
  }
