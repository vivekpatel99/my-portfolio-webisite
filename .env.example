# Copy to `.env.local` for local development. Do not commit real secrets or `.env` files.
#
# Convex deployment URL (Vite exposes only variables prefixed with VITE_)
# Required in production. Leave blank only for local UI-only development.
# Get the real value from `npx convex dev` / Convex dashboard -> Settings -> URL.
# Expected shape: https://<deployment-name>.convex.cloud
# Regional deployments can include extra labels, e.g. https://<deployment-name>.<region>.convex.cloud
VITE_CONVEX_URL=
